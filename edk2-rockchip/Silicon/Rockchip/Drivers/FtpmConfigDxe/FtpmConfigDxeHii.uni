#string STR_ENABLED_PROMPT              #language en-US "Firmware TPM"
#string STR_ENABLED_HELP                #language en-US "Enable or disable the fTPM. When disabled, the OS does not see a TPM."

#string STR_OPERATION_PROMPT            #language en-US "Pending TPM Operation"
#string STR_OPERATION_HELP              #language en-US "Runs once on the next boot. Clear erases all keys and data stored in the TPM. Change EPS gives the TPM a new endorsement key."
