[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = OpteeTpmDeviceLib
  FILE_GUID                      = 8bbc8355-2745-47cf-af60-a1f6d5625706
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = Tpm2DeviceLib|DXE_DRIVER DXE_RUNTIME_DRIVER DXE_SMM_DRIVER UEFI_APPLICATION UEFI_DRIVER

  CONSTRUCTOR                    = OpteeTpmDeviceLibConstructor
  DESTRUCTOR                     = OpteeTpmDeviceLibDestructor

[Sources]
  OpteeTpmDeviceLib.c
  OpteeTpmDeviceLibSmc.c

[Packages]
  MdePkg/MdePkg.dec
  SecurityPkg/SecurityPkg.dec
  Silicon/Rockchip/RockchipPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  PcdLib
  OpteeNvLib

[Pcd]
  gRockchipTokenSpaceGuid.PcdFtpmShmSize

[Protocols]
  gRockchipFtpmPresentProtocolGuid

[Guids]
  gRockchipFtpmTaGuid


[Depex]
  TRUE
