From 69b0723363297d7c5a382e76cb73778bc473542b Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Fri, 16 Oct 2026 15:07:05 -0500
Subject: [PATCH 2/2] plat-rockchip: rk3588: get non-secure memory from the
 DDR_MEM ATAG

Without a device tree or register_ddr() ranges OP-TEE never learns where
non-secure DRAM is, so dynamic shared memory stays disabled. Linux then
has to use the static shared memory pool, which breaks in-kernel RPMB
routing since that pool is not part of the kernel's linear map.

The DDR init blob leaves an ATAG list at 0x1fe000 whose DDR_MEM tag holds
the DRAM banks, holes and the remapped memory above the MMIO window
included. Parse it and return the banks through plat_get_nsec_memory().
OP-TEE carves its own memory out of them.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 core/arch/arm/plat-rockchip/platform_rk3588.c | 124 ++++++++++++++++++
 1 file changed, 124 insertions(+)

diff --git a/core/arch/arm/plat-rockchip/platform_rk3588.c b/core/arch/arm/plat-rockchip/platform_rk3588.c
index 3172245ee..627a257eb 100644
--- a/core/arch/arm/plat-rockchip/platform_rk3588.c
+++ b/core/arch/arm/plat-rockchip/platform_rk3588.c
@@ -11,7 +11,9 @@
 #include <io.h>
 #include <kernel/panic.h>
 #include <kernel/mutex.h>
+#include <kernel/boot.h>
 #include <kernel/tee_common_otp.h>
+#include <malloc.h>
 #include <mm/core_memprot.h>
 #include <platform.h>
 #include <platform_config.h>
@@ -180,6 +182,128 @@ TEE_Result hw_get_random_bytes(void *buf, size_t blen)
 	return TEE_SUCCESS;
 }
 
+/* ATAGs left in DRAM by the DDR init blob */
+#define ATAGS_BASE		0x1fe000
+#define ATAGS_SIZE		0x2000
+#define ATAG_ID_HASH		0x47c6a7e6
+#define ATAG_CORE		0x54410001
+#define ATAG_DDR_MEM		0x54410052
+#define ATAG_MAX		0x544100ff
+#define ATAG_DDR_MEM_BANKS	10
+
+struct rk_atag_header {
+	uint32_t size;
+	uint32_t type;
+};
+
+register_phys_mem(MEM_AREA_RAM_NSEC, ATAGS_BASE, ATAGS_SIZE);
+
+static uint32_t atag_hash(const uint8_t *data, size_t len)
+{
+	uint32_t hash = ATAG_ID_HASH;
+	size_t i = 0;
+
+	for (i = 0; i < len; i++)
+		hash ^= (hash << 5) + data[i] + (hash >> 2);
+
+	return hash;
+}
+
+static const uint8_t *find_atag(uint32_t type, size_t *len)
+{
+	const uint8_t *base = phys_to_virt(ATAGS_BASE, MEM_AREA_RAM_NSEC,
+					   ATAGS_SIZE);
+	struct rk_atag_header hdr = { };
+	size_t offs = 0;
+	uint32_t hash = 0;
+
+	if (!base)
+		return NULL;
+
+	memcpy(&hdr, base, sizeof(hdr));
+	if (hdr.type != ATAG_CORE)
+		return NULL;
+
+	while (hdr.size && hdr.type != ATAG_MAX) {
+		size_t tag_len = hdr.size * sizeof(uint32_t);
+
+		if (tag_len < sizeof(hdr) + sizeof(hash) ||
+		    tag_len > ATAGS_SIZE - offs)
+			return NULL;
+
+		if (hdr.type == type) {
+			memcpy(&hash, base + offs + tag_len - sizeof(hash),
+			       sizeof(hash));
+			if (hash &&
+			    hash != atag_hash(base + offs,
+					      tag_len - sizeof(hash)))
+				return NULL;
+
+			*len = tag_len - sizeof(hdr) - sizeof(hash);
+			return base + offs + sizeof(hdr);
+		}
+
+		offs += tag_len;
+		if (offs + sizeof(hdr) > ATAGS_SIZE)
+			return NULL;
+		memcpy(&hdr, base + offs, sizeof(hdr));
+	}
+
+	return NULL;
+}
+
+struct core_mmu_phys_mem *plat_get_nsec_memory(size_t *nelems)
+{
+	struct core_mmu_phys_mem *mem = NULL;
+	const uint8_t *tag = NULL;
+	uint64_t bank[2 * ATAG_DDR_MEM_BANKS] = { };
+	uint64_t prev_end = 0;
+	uint32_t count = 0;
+	size_t len = 0;
+	size_t i = 0;
+
+	tag = find_atag(ATAG_DDR_MEM, &len);
+	if (!tag || len < sizeof(count) * 2 + sizeof(bank)) {
+		EMSG("No DDR_MEM ATAG, dynamic shared memory unavailable");
+		return NULL;
+	}
+
+	/* count, version, then all bank bases followed by all bank sizes */
+	memcpy(&count, tag, sizeof(count));
+	if (!count || count > ATAG_DDR_MEM_BANKS) {
+		EMSG("Invalid DDR_MEM ATAG bank count %"PRIu32, count);
+		return NULL;
+	}
+	memcpy(bank, tag + 2 * sizeof(uint32_t), sizeof(bank));
+
+	for (i = 0; i < count; i++) {
+		uint64_t start = bank[i];
+		uint64_t end = start + bank[i + count];
+
+		if (end <= start || start < prev_end ||
+		    !IS_ALIGNED(start | end, SMALL_PAGE_SIZE)) {
+			EMSG("Invalid DDR_MEM ATAG bank %zu", i);
+			return NULL;
+		}
+		prev_end = end;
+	}
+
+	mem = nex_calloc(count, sizeof(*mem));
+	if (!mem)
+		return NULL;
+
+	for (i = 0; i < count; i++) {
+		mem[i].type = MEM_AREA_DDR_OVERALL;
+		mem[i].addr = bank[i];
+		mem[i].size = bank[i + count];
+		DMSG("DDR bank %zu: %#"PRIxPA" size %#"PRIxPASZ, i,
+		     mem[i].addr, mem[i].size);
+	}
+
+	*nelems = count;
+	return mem;
+}
+
 static TEE_Result generate_huk(struct tee_hw_unique_key *hwkey)
 {
 	TEE_Result res = TEE_SUCCESS;
-- 
