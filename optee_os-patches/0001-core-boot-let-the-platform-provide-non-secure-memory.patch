From 2ecdd7d0422e1bf37a1d1a9e511280a90bf1d111 Mon Sep 17 00:00:00 2001
From: Chris Blake <chrisrblake93@gmail.com>
Date: Fri, 16 Oct 2026 15:06:48 -0500
Subject: [PATCH 1/2] core: boot: let the platform provide non-secure memory

Dynamic shared memory needs to know where non-secure memory is. That
comes from a device tree, or from ranges fixed at build time with
register_ddr(). Some platforms have neither, but can find the memory
layout at runtime, for instance from data left by an earlier boot stage.

Add a weak plat_get_nsec_memory() hook that discover_nsec_memory() tries
after the device trees and before the register_ddr() ranges. The default
returns NULL and changes nothing.

Signed-off-by: Chris Blake <chrisrblake93@gmail.com>
---
 core/include/kernel/boot.h |  5 +++++
 core/kernel/boot.c         | 12 ++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/core/include/kernel/boot.h b/core/include/kernel/boot.h
index 5094d11db..636340536 100644
--- a/core/include/kernel/boot.h
+++ b/core/include/kernel/boot.h
@@ -107,6 +107,11 @@ unsigned long get_aslr_seed(void);
 
 /* Identify non-secure memory regions for dynamic shared memory */
 void discover_nsec_memory(void);
+/*
+ * Weak hook for platforms that find non-secure memory at runtime without a
+ * device tree. Returns a nex_calloc()'ed array of @nelems entries, or NULL.
+ */
+struct core_mmu_phys_mem *plat_get_nsec_memory(size_t *nelems);
 /* Add reserved memory for static shared memory in the device-tree */
 int mark_static_shm_as_reserved(struct dt_descriptor *dt);
 
diff --git a/core/kernel/boot.c b/core/kernel/boot.c
index e3b66a884..8432a3a90 100644
--- a/core/kernel/boot.c
+++ b/core/kernel/boot.c
@@ -131,6 +131,11 @@ static struct core_mmu_phys_mem *get_nsec_memory(void *fdt __unused,
 }
 #endif /*!CFG_DT*/
 
+__weak struct core_mmu_phys_mem *plat_get_nsec_memory(size_t *nelems __unused)
+{
+	return NULL;
+}
+
 void discover_nsec_memory(void)
 {
 	struct core_mmu_phys_mem *mem = NULL;
@@ -175,6 +180,13 @@ void discover_nsec_memory(void)
 		DMSG("No non-secure memory found in embedded DT");
 	}
 
+	mem = plat_get_nsec_memory(&nelems);
+	if (mem) {
+		DMSG("Non-secure memory provided by the platform");
+		core_mmu_set_discovered_nsec_ddr(mem, nelems);
+		return;
+	}
+
 	mem_begin = phys_ddr_overall_begin;
 	mem_end = phys_ddr_overall_end;
 	nelems = mem_end - mem_begin;
-- 
